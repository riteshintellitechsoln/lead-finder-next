# Copy this file to .env.local and change what you need. Restart the app after changes.
# The scripts (seed, import, migrate) read the same file.

# Accounts created on the very first start (only when there are no users yet)
ADMIN_EMAIL=admin@leadfinder.local
ADMIN_PASSWORD=admin123
USER_EMAIL=user@leadfinder.local
USER_PASSWORD=user123

# Public sign-up at /signup (false = only the admin creates accounts)
ALLOW_SIGNUP=true

# Log out users and admins after this many minutes without activity (0 = never)
SESSION_IDLE_MINUTES=5

# "Log in with Google" (the button shows only when both are set).
# Google Cloud Console > APIs & Services > Credentials > Create OAuth client ID (Web application),
# Authorised redirect URI: <APP_URL>/api/auth/google/callback  e.g. http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The site's public address (needed for Google behind nginx / a custom domain). Default: the address the browser used.
# APP_URL=https://leads.example.com

# Database file (relative to the project folder)
DB_PATH=data/leads.duckdb
# RAM DuckDB may use for caching data. 1GB suits a 4 GB server; raise it on bigger machines.
DUCKDB_MEMORY_LIMIT=1GB
# CPU threads per query (default: all cores)
# DUCKDB_THREADS=4
# Big queries running at the same time (others wait in a priority queue)
DB_CONCURRENCY=4

# Most rows one CSV download can contain
MAX_EXPORT_ROWS=100000
# Deepest row you can page to (page x page size). Narrow the filters to see more.
MAX_OFFSET=50000

# Uploaded include / exclude lists (company names, domains, emails, titles, zip codes)
MAX_LIST_MB=200
MAX_LIST_VALUES=5000000
LIST_KEEP_DAYS=180
